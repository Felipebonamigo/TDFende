# Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
MemoryCaptures/

# .NET (Tools/)
[Bb]in/
Tools/ArtPreview/out/

# IDE
.vs/
.vscode/
.idea/
*.csproj
# ...menos os das ferramentas: esses são escritos à mão, não gerados pelo Unity, e sem
# eles um clone não roda o pre-commit (FlowSim e CompileCheck somem)
!Tools/**/*.csproj
*.sln
*.user
*.suo

# Personagens do Mixamo: a licença deixa usar no jogo, mas não redistribuir o arquivo cru —
# e este repositório é público. Ficam só na máquina de quem baixou (ver ASSETS.md).
Assets/Resources/TDFende/Personagens/*.fbx
Assets/Resources/TDFende/Personagens/*.fbx.meta
Assets/Resources/TDFende/Personagens/*.fbm/
Assets/Resources/TDFende/Personagens/*.fbm.meta

# registro da sincronização automática (Tools/Sincronizar.ps1)
Tools/sincronizar.log
Tools/.baixararte.hash

# Bichos baixados (Sketchfab, Asset Store, Fab...): cada um com sua licença, muitas proíbem
# redistribuir o arquivo. Ficam só no PC; o LEIA-ME da pasta vai para o repositório.
# Exceção: os 9 bichos CC-BY que vêm com o projeto (créditos no THIRD_PARTY.md) e as
# texturas deles. Os .meta continuam fora (o Unity gera; nada referencia por GUID).
Assets/Resources/TDFende/Bichos/*
Assets/Resources/TDFende/Bichos/*.meta
!Assets/Resources/TDFende/Bichos/LEIA-ME.txt
!Assets/Resources/TDFende/Bichos/LEIA-ME.txt.meta
!Assets/Resources/TDFende/Bichos/rato.fbx
!Assets/Resources/TDFende/Bichos/cachorro.fbx
!Assets/Resources/TDFende/Bichos/lobo.fbx
!Assets/Resources/TDFende/Bichos/javali.fbx
!Assets/Resources/TDFende/Bichos/aguia.fbx
!Assets/Resources/TDFende/Bichos/urso.fbx
!Assets/Resources/TDFende/Bichos/tigre.fbx
!Assets/Resources/TDFende/Bichos/rinoceronte.fbx
!Assets/Resources/TDFende/Bichos/elefante.fbx
!Assets/Resources/TDFende/Bichos/Textures/
Assets/Resources/TDFende/Bichos/Textures/*.meta
# conversor dos bichos: GLB baixado e saída ficam fora
Tools/ConverterBichos/glb/
Tools/ConverterBichos/out/
Tools/ConverterBichos/v_*.jpg
